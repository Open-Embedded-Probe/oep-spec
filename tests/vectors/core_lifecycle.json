{
  "about": "Time is probe processing/transport time in ms. This is a contract model: max_op_ms=10000, no replay byte cache, per-route max_inflight=1 and window=64. receive queues one unique request or coalesces a pending retry; process generates an answer; sent releases route credit. Fn3 is an optional io.example.slow-query revision1 with op0x10: a side-effect-free read with empty fixed request/result, bounded by max_op_ms. Opaque durations model scheduler work, not a measured MCU or clock implementation. Zero-cache replay produces result_lost without executing.",
  "scenarios": [
    {
      "name": "owner processing pauses lease but transmission does not",
      "spec": "core §4.4/5.1/6.1/6.3",
      "events": [
        {
          "action": "receive",
          "route": 0,
          "request_hex": "010100000010785634128813000000",
          "expect": "queued"
        },
        {
          "action": "process",
          "route": 0,
          "duration_ms": 0
        },
        {
          "action": "sent",
          "route": 0
        },
        {
          "action": "check",
          "owner": 305419896,
          "remaining_ms": 5000
        },
        {
          "action": "advance",
          "ms": 1000
        },
        {
          "action": "receive",
          "route": 0,
          "request_hex": "010200000010785634128813000000",
          "expect": "queued"
        },
        {
          "action": "process",
          "route": 0,
          "duration_ms": 7000
        },
        {
          "action": "check",
          "owner": 305419896,
          "remaining_ms": 5000,
          "executions": 2
        },
        {
          "action": "advance",
          "ms": 5001
        },
        {
          "action": "check",
          "owner": 0,
          "remaining_ms": 0
        },
        {
          "action": "sent",
          "route": 0
        }
      ]
    },

            "ipv4.wifi.prefix": 24
          },
          "oep.wire.rvswd/0": {
            "rest.GPIO5": "low"
          },
          "oep.fixture.uart/0": {
            "passthrough.cdc0.rx": "GPIO1",
            "passthrough.cdc0.baud": 115200
          }
        }
      }

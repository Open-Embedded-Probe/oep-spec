{
  "about": "The settings file (docs/oep-settings-file.ja.md): a probe's declarations (fn 0's describe TLVs; each listed fn's name, instance and describe TLVs) and its get values (count x value, core §13.5) give the exported file (user values only, names for numbers, secrets as {\"secret\": true}). Importing that file into another probe gives the values to set (in the file's order), the user values to unset, the secrets the probe does not hold, and what does not resolve. Item numbers follow each fn's setting order; set values are listed in the file's category and member order.",
  "export": [
    {
      "name": "export: user values only, numbers to names",
      "spec": "settings file §2, §3",
      "probe": {
        "fn0_describe_tlvs_hex": "",
        "list": [
          {
            "fn": 1,
            "name": "oep.wire.rvswd",
            "instance": 0,
            "describe_tlvs_hex": "080d00060100000000726573742e7b7d09060001006175746f09060001016869676809050001026c6f77080d00050100000000686f6c642e7b7d"
          },
          {
            "fn": 2,
            "name": "oep.fixture.uart",
            "instance": 0,
            "describe_tlvs_hex": "081700070300000000706173737468726f7567682e7b7d2e7278081900030300000000706173737468726f7567682e7b7d2e62617564081b00060300000000706173737468726f7567682e7b7d2e666f726d61740905000300386e310905000304386531"
          }
        ]
      },
      "get_values_hex": "00000100000103004c454400000103000304004e52535400000203000301000100000301000301000100000400000303006c616200000500000300000000060100030100010000070100030400c0a8011700000801000304001800000001000102000301000201000202000201000102000100000302000100020002000003040000c20100020003000002010000",
      "file": {
        "oep_settings": 1,
        "probe": {
          "model": "rp2350",
          "unit_id": "9489dd2ae0953650",
          "firmware": "0.0.36"
        },
        "settings": {
          "core": {
            "channel.GPIO14.label": "NRST",
            "channel.GPIO14.idle": "pull-up",
            "channel.GPIO1.disable": true,
            "wifi.0.ssid": "lab",
            "wifi.0.passphrase": {
              "secret": true
            },
            "ipv4.wifi.mode": "static",
